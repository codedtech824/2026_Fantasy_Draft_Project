{
  "datasets": [
    {
      "name": "ds_standings",
      "displayName": "Final Standings",
      "query": "SELECT team, wins, losses, ties, ROUND(points_for, 1) AS points_for, ROUND(points_against, 1) AS points_against, ROUND(points_for - points_against, 1) AS point_diff FROM nfl_prediction_engine.fantasy_standings_2025 ORDER BY wins DESC, points_for DESC"
    },
    {
      "name": "ds_wins_by_team",
      "displayName": "Wins by Team",
      "query": "SELECT team, wins, losses FROM nfl_prediction_engine.fantasy_standings_2025 ORDER BY wins DESC"
    },
    {
      "name": "ds_weekly_trend",
      "displayName": "Weekly Points Trend",
      "query": "SELECT team, week, points_for FROM nfl_prediction_engine.fantasy_season_2025 WHERE result != 'BYE' ORDER BY team, week"
    },
    {
      "name": "ds_accuracy_counter",
      "displayName": "Matchup Prediction Accuracy",
      "query": "SELECT ROUND(100.0 * SUM(CASE WHEN correct THEN 1 ELSE 0 END) / COUNT(*), 1) AS accuracy_pct, SUM(CASE WHEN correct THEN 1 ELSE 0 END) AS correct_predictions, COUNT(*) AS total_predictions FROM nfl_prediction_engine.fantasy_predictions_2025"
    },
    {
      "name": "ds_accuracy_by_week",
      "displayName": "Accuracy by Week",
      "query": "SELECT week, ROUND(100.0 * SUM(CASE WHEN correct THEN 1 ELSE 0 END) / COUNT(*), 1) AS accuracy_pct, COUNT(*) AS games FROM nfl_prediction_engine.fantasy_predictions_2025 GROUP BY week ORDER BY week"
    },
    {
      "name": "ds_matchup_detail",
      "displayName": "Predicted vs Actual Matchup Detail",
      "query": "SELECT team, week, opponent, ROUND(predicted_points_for, 1) AS predicted_points_for, ROUND(actual_points_for, 1) AS actual_points_for, predicted_result, actual_result, correct FROM nfl_prediction_engine.fantasy_predictions_2025 ORDER BY week, team"
    },
    {
      "name": "ds_bracket",
      "displayName": "Playoff Bracket",
      "query": "SELECT scenario, round, week, team_a, ROUND(score_a, 1) AS score_a, team_b, ROUND(score_b, 1) AS score_b, winner FROM nfl_prediction_engine.fantasy_bracket_2025 ORDER BY scenario, CASE round WHEN 'Round 1' THEN 1 WHEN 'Semifinal' THEN 2 WHEN 'Championship' THEN 3 END"
    },
    {
      "name": "ds_champion",
      "displayName": "Predicted vs Actual Champion",
      "query": "SELECT scenario, winner AS champion FROM nfl_prediction_engine.fantasy_bracket_2025 WHERE round = 'Championship'"
    }
  ],
  "pages": [
    {
      "name": "page_2025_recap",
      "displayName": "2025 Season Recap",
      "layout": [
        {
          "widget": {
            "name": "widget_standings",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_standings",
                  "fields": [
                    {"name": "team", "expression": "`team`"},
                    {"name": "wins", "expression": "`wins`"},
                    {"name": "losses", "expression": "`losses`"},
                    {"name": "ties", "expression": "`ties`"},
                    {"name": "points_for", "expression": "`points_for`"},
                    {"name": "points_against", "expression": "`points_against`"},
                    {"name": "point_diff", "expression": "`point_diff`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {"fieldName": "team", "title": "Team", "type": "string"},
                  {"fieldName": "wins", "title": "Wins", "type": "integer"},
                  {"fieldName": "losses", "title": "Losses", "type": "integer"},
                  {"fieldName": "ties", "title": "Ties", "type": "integer"},
                  {"fieldName": "points_for", "title": "Points For", "type": "float"},
                  {"fieldName": "points_against", "title": "Points Against", "type": "float"},
                  {"fieldName": "point_diff", "title": "Point Diff", "type": "float"}
                ]
              },
              "frame": {"title": "Final Standings", "showTitle": true}
