{
  "datasets": [
    {
      "name": "ds_standings",
      "displayName": "Final Standings",
      "queryLines": [
        "SELECT team, wins, losses, ties, ROUND(points_for, 1) AS points_for, ROUND(points_against, 1) AS points_against, ROUND(points_for - points_against, 1) AS point_diff FROM nfl_prediction_engine.fantasy_standings_2025 ORDER BY wins DESC, points_for DESC"
      ]
    },
    {
      "name": "ds_wins_by_team",
      "displayName": "Wins by Team",
      "queryLines": [
        "SELECT team, wins, losses FROM nfl_prediction_engine.fantasy_standings_2025 ORDER BY wins DESC"
      ]
    },
    {
      "name": "ds_weekly_trend",
      "displayName": "Weekly Points Trend",
      "queryLines": [
        "SELECT team, week, points_for FROM nfl_prediction_engine.fantasy_season_2025 WHERE result != 'BYE' ORDER BY team, week"
      ]
    },
    {
      "name": "ds_accuracy_counter",
      "displayName": "Matchup Prediction Accuracy",
      "queryLines": [
        "SELECT ROUND(SUM(CASE WHEN correct THEN 1 ELSE 0 END) / COUNT(*), 2) AS accuracy_pct, SUM(CASE WHEN correct THEN 1 ELSE 0 END) AS correct_predictions, COUNT(*) AS total_predictions FROM nfl_prediction_engine.fantasy_predictions_2025"
      ]
    },
    {
      "name": "ds_accuracy_by_week",
      "displayName": "Accuracy by Week",
      "queryLines": [
        "SELECT week, ROUND(100.0 * SUM(CASE WHEN correct THEN 1 ELSE 0 END) / COUNT(*), 1) AS accuracy_pct, COUNT(*) AS games FROM nfl_prediction_engine.fantasy_predictions_2025 GROUP BY week ORDER BY week"
      ]
    },
    {
      "name": "ds_matchup_detail",
      "displayName": "Predicted vs Actual Matchup Detail",
      "queryLines": [
        "SELECT team, week, opponent, ROUND(predicted_points_for, 1) AS predicted_points_for, ROUND(actual_points_for, 1) AS actual_points_for, predicted_result, actual_result, correct FROM nfl_prediction_engine.fantasy_predictions_2025 ORDER BY week, team"
      ]
    },
    {
      "name": "ds_bracket",
      "displayName": "Playoff Bracket",
      "queryLines": [
        "SELECT scenario, round, week, team_a, ROUND(score_a, 1) AS score_a, team_b, ROUND(score_b, 1) AS score_b, winner FROM nfl_prediction_engine.fantasy_bracket_2025 ORDER BY scenario, CASE round WHEN 'Round 1' THEN 1 WHEN 'Semifinal' THEN 2 WHEN 'Championship' THEN 3 END"
      ]
    },
    {
      "name": "ds_champion",
      "displayName": "Predicted vs Actual Champion",
      "queryLines": [
        "SELECT scenario, winner AS champion FROM nfl_prediction_engine.fantasy_bracket_2025 WHERE round = 'Championship'"
      ]
    }
  ],
